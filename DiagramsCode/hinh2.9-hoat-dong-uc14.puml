@startuml hinh2.9-hoat-dong-uc14
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333
skinparam ActivityDiamondBackgroundColor #FEFECE
skinparam ActivityDiamondBorderColor #333333
skinparam SwimlaneBorderColor #666666
skinparam SwimlaneTitleFontSize 13

|Người dùng|
start
:Yêu cầu trả quyền điều khiển;

|Hệ thống|
if (Xe đã bị va chạm phá hủy?) then (Có)
  :Chuyển sang luồng xử lý xác xe (UC15);
else (Không)
  :Truy vấn máy chủ tìm làn đường gần nhất;
  if (Khoảng cách trong ngưỡng cho phép?) then (Có)
    :Đặt lại xe vào làn đường;\nCấp tuyến đường mới,\ntrả quyền cho máy chủ mô phỏng;
  else (Không)
    :Loại bỏ phương tiện khỏi mô phỏng;
  endif
endif

stop

