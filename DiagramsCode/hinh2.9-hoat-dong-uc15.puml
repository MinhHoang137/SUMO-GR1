@startuml hinh2.9-hoat-dong-uc15
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333
skinparam ActivityDiamondBackgroundColor #FEFECE
skinparam ActivityDiamondBorderColor #333333
skinparam SwimlaneBorderColor #666666
skinparam SwimlaneTitleFontSize 13

|Người dùng|
start
:Yêu cầu trả quyền điều khiển;

|Hệ thống|
if (Xe đã bị va chạm?) then (Có)
  :Chuyển sang luồng xử lý xác xe (UC16);
else (Không)
  :Gửi tín hiệu one-shot state=1 đến server;
  :Server xóa xe khỏi mô phỏng ngay lập tức;
  :Unity tái sử dụng đối tượng\nkhi xe vắng trong luồng tải xuống;
endif

stop

@enduml
