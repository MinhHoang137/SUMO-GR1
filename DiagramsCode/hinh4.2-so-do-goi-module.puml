@startuml hinh4.2-so-do-goi-module
!pragma layout elk

skinparam defaultFontSize 12
skinparam defaultFontName Arial
skinparam ArrowColor #555555
skinparam ArrowThickness 1.5

skinparam component {
    BackgroundColor #dae8fc
    BorderColor     #6c8ebf
    BorderThickness 1.5
    FontColor       #1a1a1a
}

skinparam package {
    BackgroundColor #f0f4ff
    BorderColor     #4a6fa5
    BorderThickness 2
    FontColor       #1a1a1a
    FontStyle       bold
    FontSize        13
}

package "Python — Mô phỏng & điều phối" as PY {
    component "Điều phối"                          as COORD
    component "Mạng\n(tách khung · nén)"           as PNET
    component "Đọc trạng thái\n(xe · đèn · người đi bộ)" as READ
    component "Xử lý xe lái"                       as UPD
    component "Sinh bản đồ & tuyến"                as GEN
    component "Lưu phiên"                          as SESS

    COORD --> PNET  : stream trạng thái (5050)
    COORD --> READ  : TraCI mỗi bước
    COORD --> UPD   : cập nhật xe lái
    COORD --> GEN   : khởi tạo kịch bản
    COORD --> SESS  : ghi frame & road data
    PNET  ..> UPD   : thread nhận (5053)
}

package "Unity — Hiển thị & tương tác" as UN {
    component "Network\n(nhận · giải nén)"         as UNET
    component "Traffic\n(TrafficerManager · TrafficLight)" as TRAFFIC
    component "UnityVehicle\n(chiếm quyền · xác xe · gửi batch)" as VEH
    component "Optimization\n(lọc vùng · giảm draw call)" as OPT
    component "UI\n(Camera · HUD · nút điều khiển)" as UI
    component "Simulation\n(Realtime · Replay)"    as SIM

    SIM     --> UNET    : khởi tạo kết nối TCP
    UNET    --> TRAFFIC : cấp dữ liệu mỗi bước
    TRAFFIC --> VEH     : quản lý vòng đời xe
    OPT     --> UI      : lắng nghe di chuyển camera
    UI      --> VEH     : chiếm / trả quyền điều khiển
    UI      --> SIM     : tạm dừng / điều chỉnh tốc độ
}

PY --> UN : "5050: dữ liệu mô phỏng"
UN --> PY : "5053: vị trí xe lái\n5054: lệnh điều khiển"

@enduml
