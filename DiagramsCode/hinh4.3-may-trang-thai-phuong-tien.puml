@startuml hinh4.3-may-trang-thai-phuong-tien

skinparam state {
    BackgroundColor<<server>> #dae8fc
    BorderColor<<server>>     #6c8ebf
    BackgroundColor<<client>> #d5e8d4
    BorderColor<<client>>     #82b366
    BackgroundColor<<wreck>>  #ffe6cc
    BorderColor<<wreck>>      #d6b656
    BackgroundColor<<dead>>   #f8cecc
    BorderColor<<dead>>       #b85450
    FontSize 13
}

state "Do  SUMO\nđiều khiển" as SERVER <<server>>
state "Do người dùng\nđiều khiển"  as CLIENT <<client>>
state "Xác xe"                      as WRECK  <<wreck>>
state "Bị hủy"                      as DEAD   <<dead>>

SERVER --> CLIENT : chiếm quyền
CLIENT --> SERVER : trả quyền\n (đưa về làn)
SERVER --> WRECK  : bị tông
CLIENT --> WRECK  : trả quyền khi \n đã va chạm
CLIENT --> DEAD   : thả quá\n xa làn
WRECK  --> DEAD   : sau N bước
DEAD   --> SERVER : tái sử dụng

@enduml
