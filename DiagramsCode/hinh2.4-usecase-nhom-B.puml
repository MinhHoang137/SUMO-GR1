@startuml hinh2.4-usecase-nhom-B
left to right direction
skinparam packageStyle rectangle
skinparam usecaseBorderColor #333333
skinparam usecaseBackgroundColor #FEFECE
skinparam actorBorderColor #333333
skinparam ArrowColor #333333

actor "Người dùng" as User
actor "SUMO" as SUMO

rectangle "Vận hành mô phỏng" {
  usecase "Chạy thời\ngian thực" as UC7
  usecase "Chạy chế độ\nphát lại" as UC8
  usecase "Chạy kèm\nsumo-gui" as UC9
  usecase "Hiển thị xe,\nđèn, người đi bộ" as INC
}

User -- UC7
User -- UC8
User -- UC9
UC7 -- SUMO
UC8 -- SUMO
UC9 -- SUMO

UC7 .> INC : <<include>>
UC8 .> INC : <<include>>

@enduml
